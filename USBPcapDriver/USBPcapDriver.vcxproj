<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{F1A88552-4027-4316-9092-86401237BA46}</ProjectGuid>
    <RootNamespace>USBPcapDriver</RootNamespace>
  </PropertyGroup>
  <Import Project="..\USBPcap.ARM64.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <!-- Windows 11 24H2, independently of the SDK/WDK used to build. -->
    <_NT_TARGET_VERSION>0xA000010</_NT_TARGET_VERSION>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(USBPcapRoot)build\$(Platform)\$(Configuration)\USBPcapDriver\</OutDir>
    <IntDir>$(USBPcapRoot)build\obj\$(Platform)\$(Configuration)\USBPcapDriver\</IntDir>
    <TargetName>USBPcap</TargetName>
    <SignMode>Off</SignMode>
    <PackageDir>$(OutDir)package\</PackageDir>
    <EnableInf2cat>true</EnableInf2cat>
    <Inf2CatWindowsVersionList>10_GE_ARM64</Inf2CatWindowsVersionList>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>wdm.lib;wdmsec.lib;ntstrsafe.lib;ntoskrnl.lib;usbd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <TimeStamp>1.5.4.0</TimeStamp>
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="USBPcapBuffer.c" />
    <ClCompile Include="USBPcapDeviceControl.c" />
    <ClCompile Include="USBPcapFilterManager.c" />
    <ClCompile Include="USBPcapGenReq.c" />
    <ClCompile Include="USBPcapHelperFunctions.c" />
    <ClCompile Include="USBPcapMain.c" />
    <ClCompile Include="USBPcapPnP.c" />
    <ClCompile Include="USBPcapPower.c" />
    <ClCompile Include="USBPcapRootHubControl.c" />
    <ClCompile Include="USBPcapQueue.c" />
    <ClCompile Include="USBPcapTables.c" />
    <ClCompile Include="USBPcapURB.c" />
    <ResourceCompile Include="USBPcap.rc" />
    <Inf Include="ARM64\USBPcap.inx" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\USBPcap.h" />
    <ClInclude Include="USBPcapMain.h" />
    <ClInclude Include="USBPcapBuffer.h" />
    <ClInclude Include="USBPcapHelperFunctions.h" />
    <ClInclude Include="USBPcapQueue.h" />
    <ClInclude Include="USBPcapRootHubControl.h" />
    <ClInclude Include="USBPcapTables.h" />
    <ClInclude Include="USBPcapURB.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
