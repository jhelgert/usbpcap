[Version]
Signature         = "$WINDOWS NT$"
Class             = USB
ClassGuid         = {36FC9E60-C465-11CF-8056-444553540000}
DriverPackageType = ClassFilter
Provider          = %PROVIDER%
CatalogFile       = USBPcaparm64.cat
PnpLockdown       = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskId1%,,,"."

[SourceDisksFiles]
USBPcap.sys = 1,,

[DefaultInstall.NTarm64]
CopyFiles = USBPcap.DriverFiles
AddReg    = USBPcap.AddReg

[DefaultInstall.NTarm64.Services]
AddService = USBPcap,,Service.AddService

[DefaultUninstall.NTarm64]
LegacyUninstall = 1
DelFiles = USBPcap.DeleteFiles
DelReg   = USBPcap.DelReg

[DefaultUninstall.NTarm64.Services]
DelService = USBPcap,0x00000200

[USBPcap.DriverFiles]
USBPcap.sys

[USBPcap.DeleteFiles]
USBPcap.sys

[USBPcap.AddReg]
; Append the class upper filter without replacing existing filters.
HKLM, System\CurrentControlSet\Control\Class\{36FC9E60-C465-11CF-8056-444553540000}, UpperFilters, 0x00010008, USBPcap

[USBPcap.DelReg]
HKLM, System\CurrentControlSet\Control\Class\{36FC9E60-C465-11CF-8056-444553540000}, UpperFilters, 0x00018002, USBPcap

[Service.AddService]
DisplayName   = %USBPcap.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 2
ServiceBinary = %12%\USBPcap.sys

[Strings]
PROVIDER        = "USBPcap"
DiskId1         = "USBPcap ARM64 Installation Disk #1"
USBPcap.SvcDesc = "USBPcap Capture Service"
